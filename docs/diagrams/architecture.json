  "cards": [
    {
      "dot": "cyan",
      "title": "采集与恢复是两条输入链",
      "items": [
        "Normalizer 不向 lift 提供字节码；采集与解码在 align 汇合。",
        "Hook 和 sink 由集成方提供；Adapter 不自动定位解释器。"
      ]
    },
    {
      "dot": "amber",
      "title": "受限语义，不猜未知指令",
      "items": [
        "内置 9 类 canonical 操作；目标 ISA 必须显式映射。",
        "CFG 检查静态栈深；JS emitter 输出有步数上限的 switch。"
      ]
    },
    {
      "dot": "rose",
      "title": "验证范围保持分层",
      "items": [
        "Alignment 只证明观察过的指令对齐；fixtures 只证明指定输入。",
        "宿主 gate / validator 与服务端验收不属于本仓工具链。"
      ]
    }
  ]
